# ============================================================
# Ecomweb — environment settings template
# ============================================================
# You normally never edit this file by hand: open https://your-store.com/install
# and the web installer creates backend/.env from this template (database,
# APP_KEY, store URL). Edit backend/.env afterwards only for things the
# admin panel does not cover (for example SMTP mail settings).
#
# Payment gateway and shipping keys can be left empty here and entered in
# Admin → Settings → Integrations instead (stored encrypted in the database;
# the admin value wins over this file).
# ============================================================

# --- Application ---------------------------------------------
APP_NAME=Ecomweb
# production on a live store; local only on your own computer.
APP_ENV=production
# Generated by the installer. Never change it after install: saved
# integration keys are encrypted with it and would become unreadable.
APP_KEY=
# Keep false on a live store (true shows error details to visitors).
APP_DEBUG=false
# The address of your store, without a trailing slash or /backend.
APP_URL=http://localhost
# Same as APP_URL unless the storefront is served from another domain.
FRONTEND_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database ------------------------------------------------
# mysql (recommended) or sqlite (quick trials; uses backend/database/database.sqlite
# unless DB_DATABASE is a full file path).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, queue ----------------------------------
# Database-backed so they work on any shared host. The queue sends order
# emails in the background — it is run by the cron job shown at the end of
# the install:  * * * * * php /path/to/backend/artisan schedule:run
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=ecomweb_session

# How long (minutes) a started checkout holds its items' stock before the
# scheduler marks it abandoned and puts the stock back. Default 10.
CHECKOUT_RESERVATION_MINUTES=10

# Proxies (Cloudflare, LiteSpeed, a load balancer) whose X-Forwarded-*
# headers are trusted, so the app knows the visitor used https. "*" trusts
# whatever sits directly in front of PHP, which is right on shared hosting.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ----------------------------------------------------
# "log" writes emails to backend/storage/logs/mail.log instead of sending them.
# To send real email, set MAIL_MAILER=smtp and fill in your SMTP details
# (cPanel → "Email Accounts" → "Connect Devices" shows them).
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Who receives "new order" emails. Comma-separated.
# Empty = the store email from Admin → Settings.
ADMIN_NOTIFICATION_EMAILS=

# --- Payment gateways ----------------------------------------
# All optional. Easier: Admin → Settings → Integrations.
# Switch each gateway on in Admin → Settings → Payments once its keys are set.

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# A *_BASE_URL line set to an empty value overrides the built-in default,
# so leave those commented out unless you need a different endpoint.

# Paymennt (PointCheckout)
# Default is live (https://api.paymennt.com). Test: https://api.test.paymennt.com
PAYMENNT_API_KEY=
PAYMENNT_API_SECRET=
PAYMENNT_PUBLIC_KEY=
PAYMENNT_WEBHOOK_SECRET=
# PAYMENNT_BASE_URL=https://api.test.paymennt.com

# Tabby
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
# Saudi merchant code, only if you also sell to KSA.
TABBY_MERCHANT_CODE_SA=
TABBY_WEBHOOK_HEADER_NAME=X-Tabby-Auth
TABBY_WEBHOOK_HEADER_VALUE=
# TABBY_BASE_URL=https://api.tabby.ai

# Tamara
# Default is the sandbox. Live: https://api.tamara.co
TAMARA_API_TOKEN=
TAMARA_PUBLIC_KEY=
TAMARA_NOTIFICATION_TOKEN=
# TAMARA_BASE_URL=https://api.tamara.co

# --- Shipping ------------------------------------------------
# All optional. Easier: Admin → Settings → Integrations.

# Aramex (international)
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
# Your Aramex branch code (e.g. DXB, AUH, RUH).
ARAMEX_ACCOUNT_ENTITY=
# Empty = the store country from Admin → Settings.
ARAMEX_ACCOUNT_COUNTRY_CODE=

# Topex (UAE domestic)
TOPEX_USERNAME=
TOPEX_PASSWORD=
TOPEX_ACCOUNT_NUMBER=

# Sender (warehouse) printed on shipping labels. Any empty field uses the
# store name, phone, email, address, city and country from Admin → Settings.
SENDER_COMPANY_NAME=
SENDER_PERSON_NAME=
SENDER_PHONE=
SENDER_EMAIL=
SENDER_ADDRESS_LINE1=
SENDER_CITY=
SENDER_STATE=
SENDER_COUNTRY_CODE=

# What the courier's "Description of goods" says on every label.
# SHIPPING_GOODS_DESCRIPTION="General Merchandise"

# --- Klaviyo (optional) --------------------------------------
# Order/checkout events, newsletter sign-up and onsite tracking. Leave
# blank to keep Klaviyo off. Onsite tracking also needs the public site ID
# saved as the klaviyo_site_id site setting. Run `php artisan config:clear`
# after changing these.
# KLAVIYO_PRIVATE_KEY=
# KLAVIYO_PUBLIC_KEY=
# KLAVIYO_NEWSLETTER_LIST_ID=
# KLAVIYO_NEWSLETTER_DOUBLE_OPT_IN=false
# KLAVIYO_CURRENCY=
